# Panel admin de Patacerca — copia este archivo a `.env` y completa los valores.
#   cp .env.example .env      (o cópialo a mano en Windows)
#
# `.env` NO se sube a git. Al ejecutar `npm run admin` (o build) se genera
# src/environments/environment.ts a partir de este archivo.

# Configuración web de Firebase: es la MISMA que usan las apps móviles.
# Puedes copiar los valores de apps/owners/.env (EXPO_PUBLIC_FIREBASE_*) o de
# Firebase Console → Configuración del proyecto → Tus apps → Web.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Los administradores NO se definen aquí: se crean en Firebase con
#   npm run admin:create -- correo@ejemplo.com
