{
  "name": "@patacerca/admin",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-env.mjs",
    "start": "ng serve --port 8083",
    "prebuild": "node scripts/generate-env.mjs",
    "build": "ng build",
    "pretypecheck": "node scripts/generate-env.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "create-admin": "node scripts/create-admin.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "firebase": "^11.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2"
  }
}
