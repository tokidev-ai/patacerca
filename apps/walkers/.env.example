# Copia este archivo a .env en esta carpeta (apps/walkers/.env).
# .env NO se sube a git.

# --- Fuente de datos ---
# true  = datos de prueba locales (sin Firebase, código SMS fijo 1234, sirve en Expo Go)
# false = Firebase real (Firestore, Storage y SMS)
EXPO_PUBLIC_USE_MOCK_DATA=true

# Rol de esta app: no cambiar.
EXPO_PUBLIC_APP_ROLE=walker

# --- Firebase Web config ---
# Firebase Console → ⚙ Configuración del proyecto → General → "Tus apps" → app Web (</>)
# → "Configuración del SDK" → opción "Configuración". Copia cada valor del objeto firebaseConfig.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- SMS de verificación (Firebase Phone Auth) ---
# Con USE_MOCK_DATA=false el registro envía un SMS real con código de 6 dígitos.
# Requiere build propia (npx expo run:android o APK); NO funciona en Expo Go.
# NO necesita variables nuevas. Solo el archivo google-services.json en esta carpeta
# (es un archivo de Firebase, no se sube a git):
#   Firebase Console → ⚙ Configuración del proyecto → General → app Android com.patacerca.walkers
#   → "Descargar google-services.json".
