{
  "name": "patacerca",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "owners": "npm --workspace=@patacerca/owners run start",
    "walkers": "npm --workspace=@patacerca/walkers run start",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"*.{md,json,js}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"*.{md,json,js}\"",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "check": "npm run typecheck && npm run format:check && npm run lint",
    "test": "npm run --workspaces --if-present test"
  },
  "devDependencies": {
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
