rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil y mascotas: las ven los usuarios con sesión (dueños ven a los paseadores).
    match /owners/{phone}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /walkers/{walkerId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // ⚠️ Documentos de verificación (carnet, selfie, antecedentes): son sensibles.
    // DESARROLLO: cualquier usuario con sesión. Antes de producción, restringir a
    // admin/Cloud Functions (p. ej. custom claim `admin`) y que el paseador solo escriba.
    match /verifications/{walkerId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
