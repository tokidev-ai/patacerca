# Copia a apps/owners/.env y apps/walkers/.env (Expo carga desde cada app).
# Nunca commitees .env con valores reales.

# --- Fuente de datos ---
# true  = AsyncStorage + seeds (@patacerca/data-mock)
# false = Firestore (@patacerca/data-firebase)
EXPO_PUBLIC_USE_MOCK_DATA=true

# owner | walker (cada app tiene su valor)
EXPO_PUBLIC_APP_ROLE=owner

# --- Firebase Web config (Console → Project settings → Your apps) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- OTP (sin WhatsApp aún: lee `code` en Firestore → otpSessions/{telefono}) ---
EXPO_PUBLIC_OTP_TTL_MINUTES=10
# Opcional: fija el código (ej. 1234). Si vacío, se genera aleatorio de 4 dígitos.
EXPO_PUBLIC_OTP_FIXED_CODE=
