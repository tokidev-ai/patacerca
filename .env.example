# Plantilla general. Expo carga el .env de CADA app, así que copia:
#   apps/owners/.env.example  → apps/owners/.env
#   apps/walkers/.env.example → apps/walkers/.env
#   apps/admin/.env.example   → apps/admin/.env
# Nunca commitees .env con valores reales.

# --- Fuente de datos ---
# true  = AsyncStorage + seeds (@patacerca/data-mock), código SMS fijo 1234
# false = Firebase (@patacerca/data-firebase) con SMS reales
EXPO_PUBLIC_USE_MOCK_DATA=true

# owner | walker (cada app tiene su valor)
EXPO_PUBLIC_APP_ROLE=owner

# --- Firebase Web config ---
# Firebase Console → ⚙ Configuración del proyecto → General → "Tus apps" → app Web (</>)
# → "Configuración del SDK" → opción "Configuración". Copia cada valor del objeto firebaseConfig.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- SMS de verificación (Firebase Phone Auth) ---
# Con USE_MOCK_DATA=false el registro envía un SMS real con código de 6 dígitos.
# Requiere build propia (npx expo run:android o APK); NO funciona en Expo Go.
# NO necesita variables nuevas. Solo el archivo google-services.json en esta carpeta
# (es un archivo de Firebase, no se sube a git):
#   Firebase Console → ⚙ Configuración del proyecto → General → app Android (com.patacerca.owners / com.patacerca.walkers)
#   → "Descargar google-services.json".
